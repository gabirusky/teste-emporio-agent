# OpenAI-compatible provider. OpenRouter is the default.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key_here
LLM_MODEL=your_model_with_tool_calling_support

# NVIDIA NIM alternative:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=your_nvidia_key_here
# LLM_MODEL=exact_nim_model_id

LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ROUNDS=4
PRODUCTS_CSV=data/products.csv
ORDERS_CSV=data/orders.csv
CUSTOMERS_CSV=data/customers.csv
CATEGORIES_CSV=data/categories.csv
PROMOTIONS_CSV=data/promotions.csv
POLICIES_PDF=data/policies.pdf
